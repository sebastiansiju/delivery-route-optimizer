### Algorithm 3: Brute Force Exact Search
```text
ROUTE_BRUTE_FORCE(graph, start)
    other_nodes <- all nodes except start
    min_distance <- INFINITY
    best_route <- []

    FOR EACH perm IN PERMUTATIONS(other_nodes) DO
        tour <- [start] + perm + [start]
        tour_dist <- CALCULATE_TOTAL_DISTANCE(tour)
        IF tour_dist < min_distance THEN
            min_distance <- tour_dist
            best_route <- tour
        ENDIF
    ENDFOR
    RETURN best_route, min_distance
