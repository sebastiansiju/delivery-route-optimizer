ROUTE_NEAREST_NEIGHBOUR(graph, start)
    route <- [start]
    current <- start
    unvisited <- all nodes except start
 
    WHILE unvisited is not empty DO
        next <- nearest unvisited node from current
        add next to route
        remove next from unvisited
        current <- next
    ENDWHILE
 
    add start to route
    return route and total distance
