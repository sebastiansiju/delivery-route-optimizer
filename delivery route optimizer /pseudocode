### Algorithm 2: 2-Opt Refinement
```text
OPTIMIZE_2OPT(route, graph)
    best_route <- route
    best_distance <- CALCULATE_TOTAL_DISTANCE(best_route)
    improved <- TRUE

    WHILE improved IS TRUE DO
        improved <- FALSE
        FOR i FROM 1 TO length(best_route) - 2 DO
            FOR k FROM i + 1 TO length(best_route) - 1 DO
                new_route <- best_route[0...i-1] + REVERSE(best_route[i...k]) + best_route[k+1...end]
                new_distance <- CALCULATE_TOTAL_DISTANCE(new_route)
                
                IF new_distance < best_distance THEN
                    best_route <- new_route
                    best_distance <- new_distance
                    improved <- TRUE
                    BREAK
                ENDIF
            ENDFOR
        ENDFOR
    ENDWHILE
    RETURN best_route, best_distance
